singular_subjects = ["he", "she", "boy", "girl"]
plural_subjects = ["they", "boys", "girls"]

singular_verbs = ["eats", "plays", "runs", "writes"]
plural_verbs = ["eat", "play", "run", "write"]

def check_agreement(sentence):

    words = sentence.lower().split()

    if len(words) < 2:
        return False

    subject = words[0]
    verb = words[1]

    if subject in singular_subjects:
        if verb in singular_verbs:
            return True

    elif subject in plural_subjects:
        if verb in plural_verbs:
            return True

    return False

sentence = input("Enter a sentence: ")

if check_agreement(sentence):
    print("Correct Subject-Verb Agreement")
else:
    print("Incorrect Subject-Verb Agreement")
