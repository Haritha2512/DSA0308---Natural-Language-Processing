
import re

def recognize_dialog_act(sentence):

    text = sentence.lower().strip()

    greetings = ["hello", "hi", "hey", "good morning",
                 "good afternoon", "good evening"]

    thanking = ["thank you", "thanks", "thank you very much"]

    agreements = ["yes", "sure", "okay", "of course",
                  "definitely", "i agree"]

    disagreements = ["no", "i disagree", "not really",
                     "i don't think so"]

    farewells = ["bye", "goodbye", "see you", "take care"]

    requests = ["please", "can you", "could you",
                "would you", "help me"]

    for word in greetings:
        if text.startswith(word):
            return "Greeting"

    for word in thanking:
        if word in text:
            return "Thanking"

    for word in farewells:
        if word in text:
            return "Farewell"

    for word in disagreements:
        if text.startswith(word):
            return "Disagreement"

    for word in agreements:
        if text.startswith(word):
            return "Agreement"

    for word in requests:
        if word in text:
            return "Requesting"

    if text.endswith("?"):
        return "Question"

    if text.endswith("!"):
        return "Exclamation"

    return "Informing"


conversation = [
    "Hello! How are you?",
    "I am fine. Thank you.",
    "Can you help me with my assignment?",
    "Sure, I can help you.",
    "Please explain the first question.",
    "I will explain it now.",
    "Thank you very much.",
    "Goodbye!"
]

print("Dialog Act Recognition Results\n")

for i, utterance in enumerate(conversation, 1):

    act = recognize_dialog_act(utterance)

    print("Utterance:", utterance)
    print("Dialog Act:", act)
    print()
