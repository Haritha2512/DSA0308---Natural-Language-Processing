import nltk
from collections import defaultdict, Counter

nltk.download('treebank')

tagged_sentences = nltk.corpus.treebank.tagged_sents()

emission_counts = defaultdict(Counter)
transition_counts = defaultdict(Counter)
tag_counts = Counter()

for sentence in tagged_sentences:
    previous_tag = "<START>"

    for word, tag in sentence:
        word = word.lower()

        emission_counts[tag][word] += 1
        transition_counts[previous_tag][tag] += 1
        tag_counts[tag] += 1

        previous_tag = tag

def emission_prob(word, tag):
    word = word.lower()
    return (emission_counts[tag][word] + 1) / (
        tag_counts[tag] + len(emission_counts[tag])
    )

def transition_prob(prev_tag, tag):
    return (transition_counts[prev_tag][tag] + 1) / (
        sum(transition_counts[prev_tag].values()) + len(tag_counts)
    )

def pos_tagging(sentence):
    words = sentence.split()
    previous_tag = "<START>"
    result = []

    for word in words:
        best_tag = None
        best_probability = 0

        for tag in tag_counts:
            probability = (
                transition_prob(previous_tag, tag) *
                emission_prob(word, tag)
            )

            if probability > best_probability:
                best_probability = probability
                best_tag = tag

        result.append((word, best_tag))
        previous_tag = best_tag

    return result

sentence = "The dog runs fast"

print("Input Sentence:", sentence)
print("\nStochastic POS Tagging:")

for word, tag in pos_tagging(sentence):
    print(word, ":", tag)
