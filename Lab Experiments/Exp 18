import re

TOKEN_PATTERN = re.compile(
    r'\s*(forall|exists|AND|OR|NOT|'
    r'[A-Za-z_][A-Za-z0-9_]*|'
    r'[(),])'
)

class FOPCParser:

    def __init__(self, expression):
        self.tokens = TOKEN_PATTERN.findall(expression)
        self.position = 0

    def current(self):
        if self.position < len(self.tokens):
            return self.tokens[self.position]
        return None

    def match(self, expected):
        if self.current() == expected:
            self.position += 1
            return True
        return False

    def parse_expression(self):

        token = self.current()

        if token in ("forall", "exists"):
            self.position += 1

            if not self.current() or not re.fullmatch(
                r'[A-Za-z_][A-Za-z0-9_]*', self.current()
            ):
                return False

            self.position += 1
            return self.parse_expression()

        elif token == "NOT":
            self.position += 1
            return self.parse_expression()

        else:
            if not self.parse_predicate():
                return False

        while self.current() in ("AND", "OR"):
            self.position += 1

            if not self.parse_expression():
                return False

        return True

    def parse_predicate(self):

        name = self.current()

        if not name or not re.fullmatch(
            r'[A-Za-z_][A-Za-z0-9_]*', name
        ):
            return False

        if name in ("forall", "exists", "AND", "OR", "NOT"):
            return False

        self.position += 1

        if not self.match("("):
            return False

        if self.current() is None:
            return False

        if not re.fullmatch(
            r'[A-Za-z_][A-Za-z0-9_]*', self.current()
        ):
            return False

        self.position += 1

        while self.match(","):
            if not self.current() or not re.fullmatch(
                r'[A-Za-z_][A-Za-z0-9_]*', self.current()
            ):
                return False
            self.position += 1

        return self.match(")")

    def validate(self):

        if self.parse_expression():
            return self.position == len(self.tokens)

        return False

expression = input("Enter FOPC expression: ")

parser = FOPCParser(expression)

if parser.validate():
    print("Valid FOPC Expression")
else:
    print("Invalid FOPC Expression")
